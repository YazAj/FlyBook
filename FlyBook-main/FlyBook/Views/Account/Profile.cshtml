@model FlyBook.Models.User

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-5">

    <h2 class="mb-4">My Profile</h2>

    <div class="card">

        <div class="card-body">

            <p>
                <strong>Name:</strong>
                @Model.FullName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

            <p>
                <strong>Role:</strong>
                @Model.Role
            </p>

            <a asp-controller="Booking"
               asp-action="Index"
               class="btn btn-primary">

                My Bookings

            </a>

            <a asp-controller="Account"
               asp-action="Logout"
               class="btn btn-danger">

                Logout

            </a>

        </div>

    </div>

</div>