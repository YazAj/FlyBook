@model FlyBook.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">

    <!-- Animated planes -->
    <div class="plane plane-1">✈</div>
    <div class="plane plane-2">✈</div>
    <div class="plane plane-3">✈</div>
    <div class="plane plane-4">✈</div>

    <div class="register-glow glow-1"></div>
    <div class="register-glow glow-2"></div>

    <div class="register-card">

        <div class="register-brand">

            <div class="register-logo">
                ✈
            </div>

            <h1>
                Fly<span>Book</span>
            </h1>

            <p>
                Create your account and start your next journey.
            </p>

        </div>


        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Full Name -->
            <div class="mb-3">

                <label asp-for="FullName"
                       class="form-label">

                    Full Name

                </label>

                <input asp-for="FullName"
                       class="form-control register-control"
                       placeholder="Enter your full name" />

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>

            </div>


            <!-- Email -->
            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">

                    Email

                </label>

                <input asp-for="Email"
                       class="form-control register-control"
                       placeholder="example@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- Password -->
            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label">

                    Password

                </label>

                <input asp-for="Password"
                       class="form-control register-control"
                       placeholder="Enter your password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- Confirm Password -->
            <div class="mb-3">

                <label asp-for="ConfirmPassword"
                       class="form-label">

                    Confirm Password

                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control register-control"
                       placeholder="Confirm your password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- Button -->
            <button type="submit"
                    class="register-btn">

                Create Account

                <span>✈</span>

            </button>

        </form>


        <div class="register-login">

            Already have an account?

            <a asp-controller="Account"
               asp-action="Login">

                Login

            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
