@model FlyBook.Models.Booking

@{
    ViewData["Title"] = "Payment";
}

<div class="container mt-5">

    <h2 class="mb-4">
        Payment
    </h2>


    <div class="row">

        <div class="col-md-7">

            <div class="card">

                <div class="card-body">

                    <h5>
                        Payment Details
                    </h5>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-controller="Payment"
                          asp-action="PayConfirmed"
                          method="post">

                        <input type="hidden"
                               name="BookingId"
                               value="@Model.BookingId" />

                        <input type="hidden"
                               name="PaymentMethod"
                               value="Card" />


                        <div class="mb-3">

                            <label class="form-label">
                                Card Number
                            </label>

                            <input type="text"
                                   name="CardNumber"
                                   class="form-control"
                                   placeholder="0000 0000 0000 0000"
                                   required />

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Expiry Date
                                </label>

                                <input type="text"
                                       name="ExpiryDate"
                                       class="form-control"
                                       placeholder="MM/YY"
                                       required />

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    CVV
                                </label>

                                <input type="password"
                                       name="CVV"
                                       class="form-control"
                                       placeholder="123"
                                       required />

                            </div>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Card Holder Name
                            </label>

                            <input type="text"
                                   name="CardHolderName"
                                   class="form-control"
                                   required />

                        </div>


                        <button type="submit"
                                class="btn btn-success w-100">

                            Pay JOD @Model.TotalPrice

                        </button>

                    </form>

                </div>

            </div>

        </div>


        <div class="col-md-5">

            <div class="card">

                <div class="card-body">

                    <h5>
                        Booking Summary
                    </h5>

                    <hr />

                    <p>

                        <strong>
                            Flight:
                        </strong>

                        @(Model.Flight?.FlightNumber ?? "N/A")

                    </p>

                    <p>

                        <strong>
                            Airline:
                        </strong>

                        @(Model.Flight?.Airline?.Name ?? "N/A")

                    </p>

                    <p>

                        <strong>
                            Route:
                        </strong>

                        @(Model.Flight?.FromAirport?.Code ?? "N/A")

                        →

                        @(Model.Flight?.ToAirport?.Code ?? "N/A")

                    </p>

                    <p>

                        <strong>
                            Payment Status:
                        </strong>

                        @(Model.Payment?.PaymentStatus ?? "Pending")

                    </p>

                    <hr />

                    <h4>
                        JOD @Model.TotalPrice
                    </h4>

                </div>

            </div>

        </div>

    </div>

</div>
