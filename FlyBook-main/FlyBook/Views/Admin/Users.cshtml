@model List<FlyBook.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="container mt-5">

    <h2 class="mb-4">Users</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>User ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Bookings</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @user.Role

                        @if (user.Role == "Admin")
                        {
                            <span class="badge bg-primary">
                                Admin
                            </span>
                        }
                    </td>
                    <td>@(user.Bookings?.Count ?? 0)</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Disabled
                            </span>
                        }
                    </td>
                    <td>
                        @if (user.Role == "Admin")
                        {
                            <span class="badge bg-primary">
                                Protected
                            </span>
                        }
                        else
                        {
                            @if (user.IsActive)
                            {
                                <form asp-action="DisableUser"
                                      asp-route-id="@user.UserId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to disable this account?');">

                                    <button type="submit"
                                            class="btn btn-warning btn-sm">
                                        Disable
                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-action="EnableUser"
                                      asp-route-id="@user.UserId"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Enable
                                    </button>

                                </form>
                            }

                            <form asp-action="DeleteUser"
                                  asp-route-id="@user.UserId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this user?');">

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }

        </tbody>

    </table>

    </div>

</div>
