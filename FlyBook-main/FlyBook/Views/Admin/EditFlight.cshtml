@model FlyBook.ViewModels.Admin.AdminFlightViewModel

@{
    ViewData["Title"] = "Edit Flight";
}

<div class="container mt-5">

    <h2 class="mb-4">Edit Flight</h2>

    <div class="card">

        <div class="card-body">

            <form asp-action="EditFlight"
                  asp-route-id="@ViewContext.RouteData.Values["id"]"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FlightNumber" class="form-label">Flight Number</label>
                        <input asp-for="FlightNumber" class="form-control" />
                        <span asp-validation-for="FlightNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AirlineId" class="form-label">Airline</label>
                        <select asp-for="AirlineId" asp-items="ViewBag.Airlines" class="form-select">
                            <option value="">Select airline</option>
                        </select>
                        <span asp-validation-for="AirlineId" class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FromAirportId" class="form-label">From Airport</label>
                        <select asp-for="FromAirportId" asp-items="ViewBag.Airports" class="form-select">
                            <option value="">Select departure airport</option>
                        </select>
                        <span asp-validation-for="FromAirportId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ToAirportId" class="form-label">To Airport</label>
                        <select asp-for="ToAirportId" asp-items="ViewBag.ToAirports" class="form-select">
                            <option value="">Select destination airport</option>
                        </select>
                        <span asp-validation-for="ToAirportId" class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="DepartureDateTime" class="form-label">Departure Date/Time</label>
                        <input asp-for="DepartureDateTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="DepartureDateTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ArrivalDateTime" class="form-label">Arrival Date/Time</label>
                        <input asp-for="ArrivalDateTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ArrivalDateTime" class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label">Price</label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AvailableSeats" class="form-label">Available Seats</label>
                        <input asp-for="AvailableSeats" class="form-control" />
                        <span asp-validation-for="AvailableSeats" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AircraftType" class="form-label">Aircraft Type</label>
                        <input asp-for="AircraftType" class="form-control" />
                        <span asp-validation-for="AircraftType" class="text-danger"></span>
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Save Changes

                </button>

                <a asp-action="Flights"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
