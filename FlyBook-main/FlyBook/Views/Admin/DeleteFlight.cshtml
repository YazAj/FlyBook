@model FlyBook.Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<div class="container mt-5">

    <div class="card">

        <div class="card-body">

            <h2>Delete Flight</h2>

            <p class="mt-3">
                Are you sure you want to delete flight
                <strong>@Model.FlightNumber</strong>
                ?
            </p>

            <p>
                @(Model.Airline?.Name ?? "N/A")
                -
                @(Model.FromAirport?.Code ?? "N/A")
                →
                @(Model.ToAirport?.Code ?? "N/A")
            </p>

            <form asp-action="DeleteFlightConfirmed"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.FlightId" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete

                </button>

                <a asp-action="Flights"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>
