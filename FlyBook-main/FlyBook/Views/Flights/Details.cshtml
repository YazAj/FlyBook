@model FlyBook.Models.Flight

@{
    ViewData["Title"] = "Flight Details";
}

<div class="container mt-5">

    <h2 class="mb-4">
        Flight Details
    </h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>Airline:</strong>
                        @(Model.Airline?.Name ?? "N/A")
                    </p>

                    <p>
                        <strong>Flight Number:</strong>
                        @Model.FlightNumber
                    </p>

                    <p>
                        <strong>Aircraft:</strong>
                        @(Model.AircraftType ?? "N/A")
                    </p>

                    <p>
                        <strong>Available Seats:</strong>
                        @Model.AvailableSeats
                    </p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>From:</strong>
                        @(Model.FromAirport?.Name ?? "N/A")
                        (@(Model.FromAirport?.Code ?? "N/A"))
                    </p>

                    <p>
                        <strong>To:</strong>
                        @(Model.ToAirport?.Name ?? "N/A")
                        (@(Model.ToAirport?.Code ?? "N/A"))
                    </p>

                    <p>
                        <strong>Departure:</strong>
                        @Model.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Arrival:</strong>
                        @Model.ArrivalDateTime.ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>

            </div>

            <hr />

            <h4>
                JOD @Model.Price
            </h4>

            <div class="mt-3">

                @if (Model.AvailableSeats > 0)
                {
                    <a asp-controller="Booking"
                       asp-action="Create"
                       asp-route-flightId="@Model.FlightId"
                       class="btn btn-primary">

                        Select

                    </a>
                }

                <a asp-controller="Flights"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

</div>
